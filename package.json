{
    "name": "jira-assistant",
    "type": "module",
    "version": "3.0.0",
    "description": "Help to track & upload work done on a Jira Ticket on timely basis and generate Worklog, Sprint and other custom reports",
    "homepage": "/",
    "author": {
        "name": "Shridhar TL",
        "email": "shridhar.tl@gmail.com"
    },
    "bugs": {
        "url": "https://jiraassistant.com/contact-us"
    },
    "private": true,
    "license": "MIT",
    "scripts": {
        "start": "cross-env VITE_BUILD_MODE=WEB vite --host --force",
        "start-extn": "cross-env VITE_BUILD_MODE=EXTN vite",
        "start-app": "concurrently -k npm:app:*",
        "build": "cross-env-shell VITE_BUILD_MODE=EXTN GENERATE_SOURCEMAP=false INLINE_RUNTIME_CHUNK=false \"tsc -b && vite build\"",
        "build-debug": "cross-env-shell VITE_BUILD_MODE=EXTN JA_DEBUG_BUILD=1 \"tsc -b && vite build\"",
        "postbuild-debug": "cross-env VITE_BUILD_MODE=EXTN node post-build.cjs",
        "postbuild": "cross-env VITE_BUILD_MODE=EXTN node post-build.cjs",
        "publish-extn": "gh-pages -d build -b ja-extn",
        "build-web": "cross-env-shell VITE_BUILD_MODE=WEB GENERATE_SOURCEMAP=false INLINE_RUNTIME_CHUNK=false \"tsc -b && vite build\"",
        "postbuild-web": "cross-env VITE_BUILD_MODE=WEB node post-build.cjs",
        "deploy-web": "echo app.jiraassistant.com > ./build/CNAME && gh-pages -d build",
        "build-app": "cross-env-shell VITE_BUILD_MODE=APP GENERATE_SOURCEMAP=false INLINE_RUNTIME_CHUNK=false \"tsc -b && vite build\"",
        "postbuild-app": "cross-env VITE_BUILD_MODE=APP node post-build.cjs",
        "deploy-app": "gh-pages -d build --dotfiles true -b ja-app",
        "start-plugin": "cross-env VITE_BUILD_MODE=PLUGIN PORT=6060 vite",
        "build-plugin": "cross-env-shell VITE_BUILD_MODE=PLUGIN PUBLIC_URL=. GENERATE_SOURCEMAP=false INLINE_RUNTIME_CHUNK=false \"tsc -b && vite build\"",
        "postbuild-plugin": "cross-env VITE_BUILD_MODE=PLUGIN node post-build.cjs",
        "app:web": "cross-env VITE_BUILD_MODE=APP vite",
        "lint": "eslint .",
        "lint-fix": "npx prettier --write ./src/ && eslint --fix ./src/"
    },
    "dependencies": {
        "@forge/api": "^8.0.0",
        "@forge/bridge": "^6.0.0",
        "@forge/resolver": "^2.0.0",
        "@fortawesome/fontawesome-free": "^7.3.0",
        "chart.js": "^4.5.1",
        "classnames": "^2.5.1",
        "date-fns": "^4.4.0",
        "dexie": "^4.4.4",
        "espree": "^11.2.0",
        "fluxo-ui": "^0.4.92",
        "exceljs": "^4.4.0",
        "firebase": "^12.15.0",
        "js-sql-parser": "^1.6.0",
        "jspdf": "github:shridhar-tl/jsPDF",
        "jspdf-autotable": "^5.0.8",
        "moment": "^2.30.1",
        "moment-timezone": "^0.6.2",
        "papaparse": "^5.5.4",
        "patternomaly": "^1.3.2",
        "queue": "^7.0.0",
        "react": "^19.2.7",
        "react-chartjs-2": "^5.3.1",
        "react-dnd": "^16.0.1",
        "react-dnd-html5-backend": "^16.0.1",
        "react-dom": "^19.2.7",
        "react-router-dom": "^7.18.1",
        "static-eval": "^2.1.1",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.2",
        "@types/node": "^26.1.0",
        "@types/papaparse": "^5.5.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "concurrently": "^10.0.3",
        "cross-env": "^10.1.0",
        "eslint": "^10.6.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "gh-pages": "^6.3.0",
        "globals": "^17.7.0",
        "sass-embedded": "^1.100.0",
        "tailwindcss": "^4.3.2",
        "tsx": "^4.23.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.62.1",
        "vite": "^8.1.3",
        "vite-plugin-html": "^3.2.2",
        "vite-plugin-mkcert": "^2.1.0",
        "vite-plugin-svgr": "^5.2.0",
        "vite-plugin-webfont-dl": "^3.12.0",
        "wait-on": "^9.0.10"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "fluxo-ui"
        ]
    }
}
