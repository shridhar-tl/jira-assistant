{
    "name": "jira-assistant",
    "type": "module",
    "version": "3.0.2",
    "description": "Help to track & upload work done on a Jira Ticket on timely basis and generate Worklog, Sprint and other custom reports",
    "homepage": "/",
    "author": {
        "name": "Shridhar TL",
        "email": "shridhar.tl@gmail.com"
    },
    "bugs": {
        "url": "https://jiraassistant.com/contact-us"
    },
    "private": true,
    "license": "MIT",
    "scripts": {
        "start": "cross-env VITE_BUILD_MODE=WEB vite --host --force",
        "start-extn": "cross-env VITE_BUILD_MODE=EXTN vite",
        "start-app": "concurrently -k npm:app:*",
        "build": "cross-env-shell VITE_BUILD_MODE=EXTN GENERATE_SOURCEMAP=false INLINE_RUNTIME_CHUNK=false \"tsc -b && vite build\"",
        "build-debug": "cross-env-shell VITE_BUILD_MODE=EXTN JA_DEBUG_BUILD=1 \"tsc -b && vite build\"",
        "postbuild-debug": "cross-env VITE_BUILD_MODE=EXTN node post-build.cjs",
        "postbuild": "cross-env VITE_BUILD_MODE=EXTN node post-build.cjs",
        "publish-extn": "gh-pages -d dist -b ja-extn",
        "build-web": "cross-env-shell VITE_BUILD_MODE=WEB GENERATE_SOURCEMAP=false INLINE_RUNTIME_CHUNK=false \"tsc -b && vite build\"",
        "postbuild-web": "cross-env VITE_BUILD_MODE=WEB node post-build.cjs",
        "deploy-web": "echo app.jiraassistant.com > ./dist/CNAME && gh-pages -d dist",
        "build-app": "cross-env-shell VITE_BUILD_MODE=APP GENERATE_SOURCEMAP=false INLINE_RUNTIME_CHUNK=false \"tsc -b && vite build\"",
        "postbuild-app": "cross-env VITE_BUILD_MODE=APP node post-build.cjs",
        "deploy-app": "gh-pages -d dist --dotfiles true -b ja-app",
        "start-plugin": "concurrently -k -n vite,forge -c cyan,blue \"npm:plugin:vite\" \"npm:plugin:tunnel\"",
        "plugin:vite": "cross-env VITE_BUILD_MODE=PLUGIN PORT=6060 vite",
        "plugin:tunnel": "wait-on -t 10000 tcp:localhost:6060 && forge tunnel",
        "build-plugin": "cross-env-shell VITE_BUILD_MODE=PLUGIN PUBLIC_URL=. GENERATE_SOURCEMAP=false INLINE_RUNTIME_CHUNK=false \"tsc -b && vite build\"",
        "postbuild-plugin": "cross-env VITE_BUILD_MODE=PLUGIN node post-build.cjs",
        "app:web": "cross-env VITE_BUILD_MODE=APP vite",
        "lint": "eslint .",
        "lint-fix": "npx prettier --write ./src/ && eslint --fix ./src/"
    },
    "dependencies": {
        "@forge/api": "^8.5.0",
        "@forge/bridge": "^7.3.0",
        "@forge/dashboards-bridge": "^2.0.3",
        "@forge/kvs": "^2.1.2",
        "@forge/realtime": "^1.0.3",
        "@forge/resolver": "^2.0.2",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "chart.js": "^4.6.1",
        "classnames": "^2.5.1",
        "date-fns": "^4.4.0",
        "dexie": "^4.4.7",
        "espree": "^11.2.0",
        "exceljs": "^4.4.0",
        "fluxo-ui": "^0.5.4",
        "js-sql-parser": "^1.6.0",
        "moment": "^2.31.0",
        "moment-timezone": "^0.6.6",
        "papaparse": "^5.7.1",
        "patternomaly": "^1.3.2",
        "planning-poker": "github:shridhar-tl/poker-site#lib",
        "react": "^19.3.1",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1",
        "static-eval": "^2.1.1",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.6",
        "@types/papaparse": "^5.5.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "concurrently": "^10.0.7",
        "cross-env": "^10.1.0",
        "eslint": "^10.14.0",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "gh-pages": "^6.3.0",
        "globals": "^17.14.0",
        "sass-embedded": "~1.108.2",
        "tailwindcss": "^4.3.5",
        "typescript": "~7.0.2",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.8",
        "vite-plugin-html": "^3.2.2",
        "vite-plugin-mkcert": "^2.1.0",
        "vite-plugin-svgr": "^5.2.0",
        "vite-plugin-webfont-dl": "^3.14.0",
        "wait-on": "^9.5.1"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "fluxo-ui"
        ]
    }
}
